{% comment %}
  MasterPortfolio-style GitHub Project Card
{% endcomment %}

{% assign repo_url = include.repository | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}
{% assign card_id = repo_owner | append: '-' | append: repo_name %}

<div
  class="mp-card"
  id="mp-card-{{ card_id }}"
  data-owner="{{ repo_owner }}"
  data-repo="{{ repo_name }}"
>
  <!-- Loading skeleton -->
  <div class="mp-loading">
    <div class="mp-loading-bar"></div>
    <div class="mp-loading-bar short"></div>
  </div>
</div>
