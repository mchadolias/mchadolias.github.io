{% assign repo_url = include.repository | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_name  = repo_url[1] %}

{% assign theme_light = "tokyonight" %}
{% assign theme_dark  = "tokyonight_dark" %}

<div class="repo-card tokyo-box hover-card fade-in">
  <a href="https://github.com/{{ include.repository }}" class="repo-link">

    <!-- LIGHT MODE -->
    <img
      class="only-light repo-image"
      src="https://github-profile-summary-cards.vercel.app/api/pin/?username={{ repo_owner }}&repo={{ repo_name }}&theme={{ theme_light }}"
      alt="{{ include.repository }}"
    >

    <!-- DARK MODE -->
    <img
      class="only-dark repo-image"
      src="https://github-profile-summary-cards.vercel.app/api/pin/?username={{ repo_owner }}&repo={{ repo_name }}&theme={{ theme_dark }}"
      alt="{{ include.repository }}"
    >

  </a>
</div>
