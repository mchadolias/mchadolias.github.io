{% assign username = include.username %}

<div id="user-profile-{{ username }}" class="tokyo-box fade-in">
  <div class="tokyo-skeleton" style="height:80px; width:140%;"></div>
</div>

<script>
const profileEl_{{ username }} = document.getElementById("user-profile-{{ username }}");

// EDIT TAGGER HERE
const userTagger_{{ username }} = "Physicist · Data Scientist · ML Engineer";

fetch("https://api.github.com/users/{{ username }}", {
  headers: { "Accept": "application/vnd.github+json" }
})
  .then(r => r.json())
  .then(async user => {
    const avatar = user.avatar_url;
    const displayName = user.name || user.login || "{{ username }}";
    const bio = user.bio || "—";

    /* ---------- Status ---------- */
    const statusEmoji = user.status?.emoji || "";
    const statusMessage = user.status?.message || "";
    const statusBlock =
      (statusEmoji || statusMessage)
        ? `<div class="tokyo-box-item meta-line">${statusEmoji} ${statusMessage}</div>`
        : "";

    /* ---------- Activity Level ---------- */
    let activityLabel = "Inactive";
    let activityEmoji = "🔴";

    try {
      const eventsRes = await fetch("https://api.github.com/users/{{ username }}/events/public");
      const events = await eventsRes.json();

      const cutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;
      const activeEvents = events.filter(ev => new Date(ev.created_at) > cutoff).length;

      if (activeEvents > 40) {
        activityEmoji = "🟢";
        activityLabel = "Highly Active";
      } else if (activeEvents > 15) {
        activityEmoji = "🟡";
        activityLabel = "Moderately Active";
      } else if (activeEvents > 0) {
        activityEmoji = "🟠";
        activityLabel = "Low Activity";
      }
    } catch(e) {
      console.warn("Activity API unavailable", e);
    }

    /* ---------- Render ---------- */
    profileEl_{{ username }}.innerHTML = `
      <div style="display:flex; align-items:center; gap:14px;">
        
        <!-- FIXED AVATAR SIZE -->
        <img src="${avatar}" 
             loading="lazy"
             alt="GitHub avatar"
             style="
               width:120px;
               height:120px;
               border-radius:50%;
               object-fit: cover;
               border:2px solid var(--tn-bg-secondary);
             ">

        <div style="line-height:1.25;">
          
          <div class="tokyo-box-title" style="margin-bottom:4px;">
            ${displayName}
          </div>

          <div class="tokyo-box-item meta-line">@${user.login}</div>

          <!-- BADGE TAGGER -->
          <div
            style="
              display:inline-block;
              margin:4px 0 6px 0;
              padding:3px 8px;
              background: var(--tn-bg-secondary);
              color: var(--tn-accent-blue);
              border-radius: 6px;
              font-size: 0.75rem;
            "
          >
            ${userTagger_{{ username }}}
          </div>

          <!-- Bio -->
          <div class="tokyo-box-item meta-line">${bio}</div>


          <!-- Status -->
          ${statusBlock}

          <!-- Activity -->
          <div class="tokyo-box-item meta-line">
            ${activityEmoji} <strong>${activityLabel}</strong>
          </div>

        </div>
      </div>
    `;
  })
  .catch(err => {
    profileEl_{{ username }}.innerHTML = `
      <div class="tokyo-box-title">Profile Unavailable</div>
      <div class="tokyo-box-item">⚠ Unable to load GitHub profile data.</div>
    `;
  });
</script>
