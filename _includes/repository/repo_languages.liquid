<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    <img
      class="only-light w-100"
      alt="{{ include.repository }}"
      src="https://github-readme-stats.vercel.app/api/top-langs/?username={{ include.username }}&theme={{ site.repo_theme_light | default: 'default' }}&locale={{ lang }}&show_icons=true&size_weight=0.3&count_weight=0.7&exclude_repo={{ include.username }}.github.io,al-folio&layout=donut"
    >
    <img
      class="only-dark w-100"
      alt="{{ include.repository }}"
      src="https://github-readme-stats.vercel.app/api/top-langs/?username={{ include.username }}&theme={{ site.repo_theme_dark | default: 'dark' }}&locale={{ lang }}&show_icons=true&size_weight=0.3&count_weight=0.7&exclude_repo={{ include.username }}.github.io,al-folio&layout=donut"
    >
  </a>
</div>